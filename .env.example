# Alpaca CLI reads ALPACA_API_KEY / ALPACA_SECRET_KEY itself when using API-key auth, or
# picks up whatever profile ALPACA_PROFILE names when using `alpaca profile login` (OAuth,
# preferred — see README). Point ALPACA_PROFILE at the "testing" profile all week; the switch
# to the dedicated $100k account's profile on Monday 8/31 9:30am ET is a one-line edit here,
# never a code change.
ALPACA_PROFILE=testing
ALPACA_LIVE_TRADE=false

# Featherless (OpenAI-compatible chat completions API)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=

# Shariah gate
SHARIAH_UNIVERSE_PATH=data/shariah_universe.json

# Risk limits (conservative defaults, tune as needed)
MAX_ORDERS_PER_DAY=3
MAX_POSITION_PCT=5
MAX_DAILY_LOSS_PCT=3

# Evidence log
DECISIONS_LOG_PATH=logs/decisions.jsonl
